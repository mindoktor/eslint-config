// tsconfig for the rule-drift fixtures under test/fixtures/ (both fail/ and
// succeed/). Separate from the root on purpose: the fixtures deliberately
// contain errors (e.g. typeError.ts), so they can't live in the root project
// that must stay green for `yarn typecheck`/`yarn build`. This project is the
// one place they ARE typechecked, on demand — the strictTypeChecked ESLint
// rules need a real TS project to resolve types against.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The fixtures import node: builtins and use globals like `process`.
    // TypeScript's automatic @types inclusion does not pick up @types/node for
    // this narrow project (it does for the root), so name it explicitly —
    // without this every import-bearing fixture emits TS2591 ("Cannot find
    // name 'node:fs'…") noise that would pollute the rule-drift snapshot.
    "types": ["node"],
    // React fixtures under fixtures/**/react/ are .tsx; allow JSX so tsc parses
    // them. They avoid needing @types/react (not a dep of this package) by
    // declaring the hooks they use locally — the react-hooks rules are AST-based
    // and fire without React's own types.
    "jsx": "react-jsx"
  },
  // A child that omits `exclude` INHERITS the parent's via `extends`; declaring
  // our own here overrides it. The root excludes all of test/, so without a
  // local exclude the inherited root exclude swallows these fixtures and the
  // include resolves to zero inputs (TS18003). Our exclude keeps only
  // node_modules and dist out, so the include below resolves the fixtures.
  "exclude": ["../node_modules", "../dist"],
  "include": ["fixtures/**/*.ts", "fixtures/**/*.tsx"]
}

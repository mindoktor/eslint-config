// Dedicated tsconfig for the rule-drift fixtures under test/fixtures/
// (both fail/ and succeed/). All of test/ is excluded from the root tsconfig
// (which must stay green for `yarn typecheck`/`yarn build`); this project is
// the one place these fixtures ARE typechecked, so the rule-drift harness can
// typecheck and typed-lint them on demand — the strictTypeChecked ESLint rules
// need a real project to resolve types against.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The fixtures import node: builtins and use globals like `process`.
    // @types/node is a transitive dep, and TypeScript's automatic @types
    // inclusion doesn't reach it from this project, so name it explicitly —
    // without this every import-bearing fixture emits TS2591 ("Cannot find
    // name 'node:fs'…") noise that would pollute the rule-drift snapshot.
    "types": ["node"]
  },
  // `include`/`exclude` in a child fully REPLACE the parent's (they don't
  // merge). The root excludes all of test/, which would exclude these fixtures;
  // declaring our own exclude here drops that root exclude, so the include
  // below resolves the fixtures instead of zero inputs (TS18003). node_modules
  // and dist are the only paths this project still needs to skip.
  "exclude": ["../node_modules", "../dist"],
  "include": ["fixtures/**/*.ts"]
}

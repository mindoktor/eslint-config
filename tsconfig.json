{
  "include": [
    "**/*.js",
    "**/*.mjs",
    "**/*.mts",
    "**/*.jsx",
    "**/*.ts",
    "**/*.d.ts",
    "**/*.tsx",
    ".release-it.ts",
    "eslint.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    // The rule-drift harness is dev tooling, not package source: it must not be
    // emitted into dist/ (which is what ships) nor typechecked by the root
    // `yarn build`/`yarn typecheck`. It carries its own projects instead —
    // test/tsconfig.json for the harness, test/tsconfig.fixtures.json for the
    // fail/ and succeed/ fixtures.
    "test"
  ],
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "allowSyntheticDefaultImports": true,
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
  },
}
